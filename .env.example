# ============================================================
# Knowledge Observatory 环境变量模板
#
# 使用方法：
#   - 后端变量：复制本文件为 `backend/.env` 并填入真实值
#   - 前端变量：复制到 `frontend/.env.local`（Next.js 自动读取）
#
# 注意：`.env` / `.env.local` 含真实密钥，已被 .gitignore 忽略，禁止提交；
#       本 `.env.example` 是唯一允许上传的模板（只含占位符）。
# ============================================================

# ---------- 后端（backend/.env） ----------

# LLM（OpenAI 兼容接口，可选）。不配置时 RAG/Agent 只检索不生成。
# DeepSeek：
#   LLM_API_BASE=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
# OpenAI：
#   LLM_API_BASE=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
# 本地 Ollama（key 可留空）：
#   LLM_API_BASE=http://localhost:11434/v1
#   LLM_MODEL=llama3
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 数据库（默认使用 backend/knowledge.db，一般无需修改）
# DATABASE_URL=sqlite:///./knowledge.db

# 允许的前端来源（逗号分隔）
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- 前端（frontend/.env.local） ----------

# 后端地址（默认 http://127.0.0.1:8000，一般无需修改）
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
